// Askane Test Script 2.0 (v0.10.2-fix)
// Showcases: ??, ?., match guards, ${...} interpolation, short lambdas |x|, dot-assign, json, math

import math;
import json;
import sys;

let t_start = clock();

fn rank(score) {
    match score {
        100 => "S",
        0 => "F",
        s if s >= 80 => "A",
        s if s >= 50 => "B",
        _ => "C",
    }
}

fn make_hero(name, hp) {
    let state = #{ name: name, hp: hp, hits: 0 };
    |dmg| {
        state.hp = math.max(0, state.hp - dmg);
        state.hits = state.hits + 1;
        state
    }
}

let hit = make_hero("Askane", 100);
hit(15);
let hero = hit(20);
let mana = hero?.mana ?? 50;

let passed = [35, 55, 82, 100, 48]
    |> filter(|s| s >= 50)
    |> map(|s| #{ score: s, grade: rank(s) });

let report = #{
    os: sys.os(),
    arch: sys.arch(),
    hero: hero,
    mana: mana,
    passed: passed,
    elapsed_ms: math.round((clock() - t_start) * 1000.0),
};

let encoded = json.stringify(report);
let decoded = json.parse(encoded);

println("=== Askane v0.10.2-fix Showcase ===");
println("Hero: ${decoded.hero.name} | HP: ${decoded.hero.hp} | Mana: ${decoded.mana} | Hits: ${decoded.hero.hits}");
println("Passed: ${len(decoded.passed)}");
for item in decoded.passed {
    println("  score: ${item.score} -> grade: ${item.grade}");
}
println("JSON: ${encoded}");
println("Done in ${decoded.elapsed_ms} ms");
